# Test Environment Configuration
# Copy this file to .env.test and fill in the values (optional for local tests)
#
# Most test settings have sensible defaults in config/test.exs
# This file is only needed if you want to override specific values

# Database Configuration (optional - defaults in config/test.exs)
# Uses portfolio_test database with async sandboxing by default
# DATABASE_URL=ecto://postgres:postgres@localhost/portfolio_test

# Session Configuration (optional)
# SESSION_EXPIRATION_SECONDS=3600

# Disable async tests if needed (optional)
# MIX_TEST_MAX_CASES=1
