# Development Environment Configuration
# Copy this file to .env.dev and fill in the values (optional for local dev)
#
# Most development settings have sensible defaults in config/dev.exs
# This file is only needed if you want to override specific values

# Database Configuration (optional - defaults in config/dev.exs)
# DATABASE_URL=ecto://postgres:postgres@localhost/portfolio_dev

# Session Configuration (optional)
# SESSION_EXPIRATION_SECONDS=3600

# Application Host (optional, defaults to localhost)
# PHX_HOST=localhost

# Enable server mode (optional, usually not needed in dev)
# PHX_SERVER=true
