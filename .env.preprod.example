# Portfolio Preproduction Environment Configuration
#
# Copy this file to .env.preprod and adjust values as needed
# cp .env.preprod.example .env.preprod
#
# This configuration is used by docker-compose.preprod.yml

# ============================================================================
# Database Configuration
# ============================================================================

DATABASE_URL=ecto://portfolio:portfolio_preprod_password@postgres:5432/portfolio_preprod

# ============================================================================
# Application Configuration
# ============================================================================

PHX_HOST=localhost
PHX_SERVER=true
PORT=4000

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=CHANGEME_generate_with_mix_phx_gen_secret_this_is_only_an_example

# ============================================================================
# Environment
# ============================================================================

MIX_ENV=prod
RELEASE_NODE=portfolio@127.0.0.1
RELEASE_COOKIE=portfolio_preprod_cookie_changeme

# ============================================================================
# File Storage
# ============================================================================

FILE_STORAGE_BACKEND=LocalStorage
FILE_STORAGE_BASE_PATH=/app/priv/static/uploads

# ============================================================================
# Authentication Configuration
# ============================================================================

AUTH_SESSION_MAX_AGE_DAYS=30
AUTH_MAGIC_LINK_TTL_MINUTES=30
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_RATE_LIMITING=true
SESSION_EXPIRATION_SECONDS=7200

# ============================================================================
# Oban (Background Jobs)
# ============================================================================

# Disable Oban in preprod if you don't need background jobs
# OBAN_ENABLED=false

# ============================================================================
# External Services (Optional - for testing integrations)
# ============================================================================

# Email service (if testing email functionality)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=password

# S3/Storage (if testing cloud storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your-bucket-name
# S3_REGION=eu-west-1

# ============================================================================
# Notes
# ============================================================================
#
# 1. SECRET_KEY_BASE must be generated with: mix phx.gen.secret
#    Never use the example value in actual deployments!
#
# 2. Database credentials should match docker-compose.preprod.yml
#
# 3. This configuration mimics production but with test-friendly values
#
# 4. Keep this file out of git (.gitignore should exclude .env.preprod)
