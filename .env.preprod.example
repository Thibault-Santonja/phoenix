# Pre-production Environment Configuration
# Copy this file to .env.preprod and fill in the values
#
# Usage: docker-compose -f docker-compose.preprod.yml --env-file .env.preprod up

# Database Configuration (required)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=portfolio_preprod

# Application Secrets (required)
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=your_64_character_secret_key_base_here

# Release Cookie (required)
# Generate with: mix phx.gen.secret 32
RELEASE_COOKIE=your_release_cookie_here

# Application Host (optional, defaults to localhost)
PHX_HOST=localhost
