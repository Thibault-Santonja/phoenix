<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">IP Whitelist</h1>
    <.link patch={~p"/admin/ip-whitelist/new"}>
      <span class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 inline-block">
        Add IP
      </span>
    </.link>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <%= if @entries == [] do %>
      <div class="p-8 text-center text-gray-500">
        No whitelisted IPs
      </div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              IP Address
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Description
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Created By
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Date
            </th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <%= for entry <- @entries do %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {entry.ip_address}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                {entry.description || "-"}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= if entry.created_by do %>
                  {entry.created_by.email}
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                {Calendar.strftime(entry.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <.link
                  patch={~p"/admin/ip-whitelist/#{entry.id}/edit"}
                  class="text-blue-600 hover:text-blue-900 mr-4"
                >
                  Edit
                </.link>
                <button
                  phx-click="delete"
                  phx-value-id={entry.id}
                  data-confirm="Are you sure you want to delete this IP?"
                  class="text-red-600 hover:text-red-900"
                >
                  Delete
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="ip-whitelist-modal"
  show
  on_cancel={JS.patch(~p"/admin/ip-whitelist")}
>
  <.live_component
    module={PortfolioWeb.Admin.IPWhitelistLive.FormComponent}
    id={@ip_whitelist.id || :new}
    title={@page_title}
    action={@live_action}
    ip_whitelist={@ip_whitelist}
    current_user={@current_user}
    patch={~p"/admin/ip-whitelist"}
  />
</.modal>
