<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8">Mon profil</h1>
  
<!-- Informations du compte -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-xl font-semibold mb-4">Informations du compte</h2>

    <.form for={@form} phx-submit="save">
      <div class="mb-4">
        <.input field={@form[:name]} label="Nom" placeholder="Votre nom" />
      </div>

      <div class="mb-4">
        <.input field={@form[:email]} type="email" label="Email" value={@user.email} disabled />
        <p class="text-sm text-gray-500 mt-1">
          L'email ne peut pas être modifié. Contactez un administrateur si nécessaire.
        </p>
      </div>

      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Rôle</label>
        <p class="text-gray-900 capitalize">{@user.role}</p>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Membre depuis</label>
        <p class="text-gray-900">{Calendar.strftime(@user.inserted_at, "%d/%m/%Y")}</p>
      </div>

      <.button
        type="submit"
        class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700"
      >
        Enregistrer
      </.button>
    </.form>
  </div>
  
<!-- Sessions actives -->
  <div class="bg-white shadow rounded-lg p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold">Sessions actives</h2>
      <%= if length(@sessions) > 1 do %>
        <button
          phx-click="revoke_all_sessions"
          data-confirm="Êtes-vous sûr de vouloir déconnecter toutes les autres sessions ?"
          class="text-sm text-red-600 hover:text-red-800 font-medium"
        >
          Déconnecter toutes les autres sessions
        </button>
      <% end %>
    </div>

    <div class="space-y-3">
      <%= if @sessions == [] do %>
        <p class="text-gray-500 text-sm">Aucune session active</p>
      <% else %>
        <%= for session <- @sessions do %>
          <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg">
            <div class="flex-1">
              <p class="text-sm font-medium">
                <%= if @current_session && session.id == @current_session.id do %>
                  <span class="inline-flex items-center">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                    <span class="text-green-700">Session actuelle</span>
                  </span>
                <% else %>
                  <span class="text-gray-700">Session</span>
                <% end %>
              </p>
              <p class="text-xs text-gray-500 mt-1">
                Dernière activité : {Calendar.strftime(
                  session.last_activity_at,
                  "%d/%m/%Y à %H:%M"
                )}
              </p>
            </div>
            <%= if !@current_session || session.id != @current_session.id do %>
              <button
                phx-click="revoke_session"
                phx-value-id={session.id}
                data-confirm="Êtes-vous sûr de vouloir révoquer cette session ?"
                class="ml-4 text-sm text-red-600 hover:text-red-800 font-medium"
              >
                Révoquer
              </button>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
