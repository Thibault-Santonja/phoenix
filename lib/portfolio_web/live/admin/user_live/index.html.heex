<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- En-tête avec bouton retour -->
  <div class="flex items-start justify-between mb-4">
    <.back_to_dashboard />
    <.admin_logout_button current_user={@current_user} />
  </div>

  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">
      Gestion des utilisateurs
    </h1>
    <p class="mt-2 text-gray-600">
      {length(@users)} utilisateur(s) au total
    </p>
  </div>

<!-- Liste des utilisateurs -->
  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th
            scope="col"
            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >
            Utilisateur
          </th>
          <th
            scope="col"
            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >
            Rôle
          </th>
          <th
            scope="col"
            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >
            Créé le
          </th>
          <th
            scope="col"
            class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >
            Dernière activité
          </th>
          <th scope="col" class="relative px-6 py-3">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <%= for user <- @users do %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center">
                    <span class="text-blue-600 font-semibold text-sm">
                      {String.first(user.email) |> String.upcase()}
                    </span>
                  </div>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900">
                    {user.email}
                  </div>
                  <%= if user.name do %>
                    <div class="text-sm text-gray-500">
                      {user.name}
                    </div>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class={[
                "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
                if user.role == :admin do
                  "bg-purple-100 text-purple-800"
                else
                  "bg-gray-100 text-gray-800"
                end
              ]}>
                {user.role |> Atom.to_string() |> String.capitalize()}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {Calendar.strftime(user.inserted_at, "%d/%m/%Y")}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {Calendar.strftime(user.updated_at, "%d/%m/%Y à %H:%M")}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= if user.id == @current_user.id do %>
                <span class="text-gray-400 italic">Vous</span>
              <% else %>
                <button class="text-gray-400 hover:text-gray-600 disabled:opacity-50" disabled>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"
                    />
                  </svg>
                </button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

<!-- Message si aucun utilisateur -->
  <%= if Enum.empty?(@users) do %>
    <div class="text-center py-12">
      <svg
        class="mx-auto h-12 w-12 text-gray-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
        />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun utilisateur</h3>
      <p class="mt-1 text-sm text-gray-500">
        Il n'y a aucun utilisateur dans le système.
      </p>
    </div>
  <% end %>

<!-- Statistiques en bas -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <.link
      patch={~p"/admin/users"}
      class={[
        "bg-white rounded-lg shadow p-4 border border-gray-200 transition-all cursor-pointer block",
        if @filter == nil do
          "border-l-4 border-l-blue-500"
        else
          "hover:shadow-lg hover:border-blue-300"
        end
      ]}
    >
      <div class="text-sm font-medium text-gray-600">Total utilisateurs</div>
      <div class="mt-1 text-2xl font-bold text-gray-900">
        {@user_stats.total}
      </div>
    </.link>

    <.link
      patch={if @filter == "admin", do: ~p"/admin/users", else: ~p"/admin/users?filter=admin"}
      class={[
        "bg-white rounded-lg shadow p-4 border border-gray-200 transition-all cursor-pointer block",
        if @filter == "admin" do
          "border-l-4 border-l-purple-500"
        else
          "hover:shadow-lg hover:border-purple-300"
        end
      ]}
    >
      <div class="text-sm font-medium text-gray-600">Administrateurs</div>
      <div class="mt-1 text-2xl font-bold text-purple-600">
        {@user_stats.admins}
      </div>
    </.link>

    <.link
      patch={if @filter == "user", do: ~p"/admin/users", else: ~p"/admin/users?filter=user"}
      class={[
        "bg-white rounded-lg shadow p-4 border border-gray-200 transition-all cursor-pointer block",
        if @filter == "user" do
          "border-l-4 border-l-gray-500"
        else
          "hover:shadow-lg hover:border-gray-300"
        end
      ]}
    >
      <div class="text-sm font-medium text-gray-600">Utilisateurs</div>
      <div class="mt-1 text-2xl font-bold text-gray-600">
        {@user_stats.regular_users}
      </div>
    </.link>
  </div>
</div>
