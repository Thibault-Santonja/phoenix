<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Bouton retour et logout alignés -->
  <div class="flex items-start justify-between mb-4">
    <.back_to_dashboard />
    <.admin_logout_button current_user={@current_user} />
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold text-gray-900">{gettext("admin.albums.index.title")}</h1>
      <p class="mt-2 text-sm text-gray-700">
        {gettext("admin.albums.index.subtitle")}
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16">
      <.link
        navigate={~p"/admin/albums/new"}
        class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
      >
        {gettext("admin.albums.index.new_album")}
      </.link>
    </div>
  </div>
  
<!-- Filtres -->
  <div class="mt-6 flex items-center gap-2">
    <span class="text-sm font-medium text-gray-700">
      {gettext("admin.albums.index.filter_label")}
    </span>
    <.link
      navigate={~p"/admin/albums"}
      class={[
        "inline-flex items-center px-3 py-1 rounded-full text-sm font-medium transition-colors",
        if @filter == nil do
          "bg-indigo-100 text-indigo-800"
        else
          "bg-gray-100 text-gray-700 hover:bg-gray-200"
        end
      ]}
    >
      {gettext("admin.albums.index.filter_all")}
      <span class="ml-1.5 text-xs">
        ({@count_stats.all})
      </span>
    </.link>
    <.link
      navigate={~p"/admin/albums?filter=published"}
      class={[
        "inline-flex items-center px-3 py-1 rounded-full text-sm font-medium transition-colors",
        if @filter == "published" do
          "bg-green-100 text-green-800"
        else
          "bg-gray-100 text-gray-700 hover:bg-gray-200"
        end
      ]}
    >
      {gettext("admin.albums.index.filter_published")}
      <span class="ml-1.5 text-xs">
        ({@count_stats.published})
      </span>
    </.link>
    <.link
      navigate={~p"/admin/albums?filter=draft"}
      class={[
        "inline-flex items-center px-3 py-1 rounded-full text-sm font-medium transition-colors",
        if @filter == "draft" do
          "bg-orange-100 text-orange-800"
        else
          "bg-gray-100 text-gray-700 hover:bg-gray-200"
        end
      ]}
    >
      {gettext("admin.albums.index.filter_drafts")}
      <span class="ml-1.5 text-xs">
        ({@count_stats.draft})
      </span>
    </.link>
  </div>

  <%= if @albums == [] do %>
    <div class="mt-8 text-center">
      <svg
        class="mx-auto h-12 w-12 text-gray-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
        />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">
        {gettext("admin.albums.index.no_albums")}
      </h3>
      <p class="mt-1 text-sm text-gray-500">
        {gettext("admin.albums.index.no_albums_hint")}
      </p>
      <div class="mt-6">
        <.link
          navigate={~p"/admin/albums/new"}
          class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
        >
          {gettext("admin.albums.index.create_album")}
        </.link>
      </div>
    </div>
  <% else %>
    <div class="mt-8 flex flex-col">
      <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th
                    scope="col"
                    class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6"
                  >
                    <.sortable_header
                      column="title"
                      label={gettext("admin.albums.index.column_title")}
                      current_sort_by={@sort_by}
                      current_sort_order={@sort_order}
                      filter={@filter}
                    />
                  </th>
                  <th
                    scope="col"
                    class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                  >
                    <.sortable_header
                      column="type"
                      label={gettext("admin.albums.index.column_type")}
                      current_sort_by={@sort_by}
                      current_sort_order={@sort_order}
                      filter={@filter}
                    />
                  </th>
                  <th
                    scope="col"
                    class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                  >
                    <.sortable_header
                      column="date"
                      label={gettext("admin.albums.index.column_date")}
                      current_sort_by={@sort_by}
                      current_sort_order={@sort_order}
                      filter={@filter}
                    />
                  </th>
                  <th
                    scope="col"
                    class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                  >
                    <.sortable_header
                      column="photos"
                      label={gettext("admin.albums.index.column_photos")}
                      current_sort_by={@sort_by}
                      current_sort_order={@sort_order}
                      filter={@filter}
                    />
                  </th>
                  <th
                    scope="col"
                    class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                  >
                    <.sortable_header
                      column="published"
                      label={gettext("admin.albums.index.column_published")}
                      current_sort_by={@sort_by}
                      current_sort_order={@sort_order}
                      filter={@filter}
                    />
                  </th>
                  <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                    <span class="sr-only">{gettext("admin.albums.index.actions")}</span>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <%= for album <- @albums do %>
                  <tr>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                      <div class="font-medium text-gray-900">{album.title}</div>
                      <%= if album.location do %>
                        <div class="text-gray-500">{album.location}</div>
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <span class={"inline-flex rounded-full px-2 text-xs font-semibold leading-5 #{type_badge_class(album.type)}"}>
                        {format_type(album.type)}
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      {Calendar.strftime(album.date_prise_vue, "%d/%m/%Y")}
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      {album.photo_count}
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <button
                        type="button"
                        phx-click="toggle_publish"
                        phx-value-id={album.id}
                        class={[
                          "relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 phx-submit-loading:opacity-50 phx-submit-loading:cursor-wait",
                          if(album.published, do: "bg-indigo-600", else: "bg-gray-200")
                        ]}
                      >
                        <span class="sr-only">Toggle published</span>
                        <span class={[
                          "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out",
                          if(album.published, do: "translate-x-5", else: "translate-x-0")
                        ]}>
                        </span>
                      </button>
                    </td>
                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                      <.link
                        navigate={~p"/admin/albums/#{album.id}/edit"}
                        class="text-indigo-600 hover:text-indigo-900 mr-4"
                      >
                        {gettext("admin.albums.index.edit")}
                      </.link>
                      <a
                        href="#"
                        phx-click="delete"
                        phx-value-id={album.id}
                        data-confirm={gettext("admin.albums.index.delete_confirm")}
                        class="text-red-600 hover:text-red-900 phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
                      >
                        <span class="phx-click-loading:hidden">
                          {gettext("admin.albums.index.delete")}
                        </span>
                        <span class="hidden phx-click-loading:inline">
                          {gettext("admin.albums.index.deleting")}
                        </span>
                      </a>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  
<!-- Pagination -->
  <%= if @total_pages > 1 do %>
    <div class="mt-6 flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
      <div class="flex flex-1 justify-between sm:hidden">
        <%= if @page > 1 do %>
          <.link
            patch={~p"/admin/albums?#{build_params(@filter, @page - 1, @sort_by, @sort_order)}"}
            class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
          >
            {gettext("admin.albums.index.previous")}
          </.link>
        <% end %>
        <%= if @page < @total_pages do %>
          <.link
            patch={~p"/admin/albums?#{build_params(@filter, @page + 1, @sort_by, @sort_order)}"}
            class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
          >
            {gettext("admin.albums.index.next")}
          </.link>
        <% end %>
      </div>
      <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-gray-700">
            {gettext("admin.albums.index.showing")}
            <span class="font-medium">{(@page - 1) * @per_page + 1}</span>
            {gettext("admin.albums.index.to")}
            <span class="font-medium">{min(@page * @per_page, @total_albums)}</span>
            {gettext("admin.albums.index.of")} <span class="font-medium">{@total_albums}</span>
            {gettext("admin.albums.index.albums_count")}
          </p>
        </div>
        <div>
          <nav
            class="isolate inline-flex -space-x-px rounded-md shadow-sm"
            aria-label="Pagination"
          >
            <%= if @page > 1 do %>
              <.link
                patch={
                  ~p"/admin/albums?#{build_params(@filter, @page - 1, @sort_by, @sort_order)}"
                }
                class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
              >
                <span class="sr-only">{gettext("admin.albums.index.previous")}</span>
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
                    clip-rule="evenodd"
                  />
                </svg>
              </.link>
            <% end %>

            <%= for page_num <- pagination_range(@page, @total_pages) do %>
              <%= if page_num == @page do %>
                <span class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                  {page_num}
                </span>
              <% else %>
                <.link
                  patch={
                    ~p"/admin/albums?#{build_params(@filter, page_num, @sort_by, @sort_order)}"
                  }
                  class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
                >
                  {page_num}
                </.link>
              <% end %>
            <% end %>

            <%= if @page < @total_pages do %>
              <.link
                patch={
                  ~p"/admin/albums?#{build_params(@filter, @page + 1, @sort_by, @sort_order)}"
                }
                class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
              >
                <span class="sr-only">{gettext("admin.albums.index.next")}</span>
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                    clip-rule="evenodd"
                  />
                </svg>
              </.link>
            <% end %>
          </nav>
        </div>
      </div>
    </div>
  <% end %>
</div>
