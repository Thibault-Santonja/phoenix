<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- En-tête -->
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">
      Tableau de bord administrateur
    </h1>
    <p class="mt-2 text-gray-600">
      Bienvenue, <%= @current_user.email %>
    </p>
  </header>

  <!-- Statistiques -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Statistiques</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Total Albums -->
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Total Albums</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">
              <%= @stats.total_albums %>
            </p>
          </div>
          <div class="bg-blue-100 rounded-full p-3">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
        </div>
        <div class="mt-4 flex items-center text-sm">
          <span class="text-green-600 font-medium"><%= @stats.published_albums %></span>
          <span class="text-gray-600 ml-1">publiés</span>
          <span class="text-gray-400 mx-2">•</span>
          <span class="text-gray-600"><%= @stats.draft_albums %></span>
          <span class="text-gray-600 ml-1">brouillons</span>
        </div>
      </div>

      <!-- Total Photos -->
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Total Photos</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">
              <%= @stats.total_photos %>
            </p>
          </div>
          <div class="bg-green-100 rounded-full p-3">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Albums Publiés -->
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-purple-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Albums Publiés</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">
              <%= @stats.published_albums %>
            </p>
          </div>
          <div class="bg-purple-100 rounded-full p-3">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
        <div class="mt-4 text-sm text-gray-600">
          <%= if @stats.total_albums > 0 do %>
            <%= Float.round(@stats.published_albums / @stats.total_albums * 100, 1) %>% du total
          <% else %>
            0% du total
          <% end %>
        </div>
      </div>

      <!-- Utilisateurs -->
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-orange-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Utilisateurs</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">
              <%= @stats.total_users %>
            </p>
          </div>
          <div class="bg-orange-100 rounded-full p-3">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Actions rapides -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Actions rapides</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Gérer les albums -->
      <.link
        navigate={~p"/admin/albums"}
        class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border border-gray-200 hover:border-blue-400"
      >
        <div class="flex items-start">
          <div class="bg-blue-100 rounded-lg p-3">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <div class="ml-4 flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Gérer les albums</h3>
            <p class="mt-1 text-sm text-gray-600">
              Créer, modifier et organiser vos albums photo
            </p>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </.link>

      <!-- Créer un album -->
      <.link
        navigate={~p"/admin/albums/new"}
        class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border border-gray-200 hover:border-green-400"
      >
        <div class="flex items-start">
          <div class="bg-green-100 rounded-lg p-3">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </div>
          <div class="ml-4 flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Créer un album</h3>
            <p class="mt-1 text-sm text-gray-600">
              Ajouter un nouvel album à votre portfolio
            </p>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </.link>

      <!-- Modifier le profil -->
      <.link
        navigate={~p"/admin/profile"}
        class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border border-gray-200 hover:border-purple-400"
      >
        <div class="flex items-start">
          <div class="bg-purple-100 rounded-lg p-3">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <div class="ml-4 flex-1">
            <h3 class="text-lg font-semibold text-gray-900">Mon profil</h3>
            <p class="mt-1 text-sm text-gray-600">
              Modifier vos informations personnelles
            </p>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </.link>
    </div>
  </section>

  <!-- Informations système -->
  <section>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations</h2>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-gray-600">Email du compte</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @current_user.email %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Rôle</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              <%= String.capitalize(to_string(@current_user.role)) %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Compte créé le</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= Calendar.strftime(@current_user.inserted_at, "%d/%m/%Y à %H:%M") %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Dernière mise à jour</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= Calendar.strftime(@current_user.updated_at, "%d/%m/%Y à %H:%M") %>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</div>
