<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- En-tête -->
  <header class="mb-8 flex items-start justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        Tableau de bord administrateur
      </h1>
      <p class="mt-2 text-gray-600">
        Bienvenue, {@current_user.email}
      </p>
    </div>
    <.admin_logout_button current_user={@current_user} />
  </header>
  
<!-- Statistiques -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Statistiques</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Total Albums -->
      <.stat_card
        title="Total Albums"
        value={@stats.total_albums}
        icon="hero-folder"
        color="blue"
        navigate={~p"/admin/albums"}
      >
        <:footer>
          <div class="flex items-center text-sm text-blue-600 font-medium">
            <span>Voir la liste</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </div>
        </:footer>
      </.stat_card>
      
<!-- Total Photos -->
      <.stat_card
        title="Total Photos"
        value={@stats.total_photos}
        icon="hero-photo"
        color="green"
        navigate={~p"/admin/photos"}
      />
      
<!-- Albums Publiés -->
      <.stat_card
        title="Albums Publiés"
        value={@stats.published_albums}
        icon="hero-check-circle"
        color="purple"
        navigate={~p"/admin/albums?filter=published"}
      >
        <:footer>
          <div class="text-sm text-gray-600">
            <%= if @stats.total_albums > 0 do %>
              {Float.round(@stats.published_albums / @stats.total_albums * 100, 1)}% du total
            <% else %>
              0% du total
            <% end %>
          </div>
        </:footer>
      </.stat_card>
      
<!-- Albums Brouillons -->
      <.stat_card
        title="Albums Brouillons"
        value={@stats.draft_albums}
        icon="hero-pencil-square"
        color="red"
        navigate={~p"/admin/albums?filter=draft"}
      >
        <:footer>
          <div class="text-sm text-gray-600">
            <%= if @stats.total_albums > 0 do %>
              {Float.round(@stats.draft_albums / @stats.total_albums * 100, 1)}% du total
            <% else %>
              0% du total
            <% end %>
          </div>
        </:footer>
      </.stat_card>
      
<!-- Utilisateurs -->
      <.stat_card
        title="Utilisateurs"
        value={@stats.total_users}
        icon="hero-users"
        color="orange"
        navigate={~p"/admin/users"}
      >
        <:footer>
          <div class="flex items-center text-sm text-orange-600 font-medium">
            <span>Voir la liste</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </div>
        </:footer>
      </.stat_card>
    </div>
  </section>
  
<!-- Actions rapides -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Actions rapides</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Gérer les albums -->
      <.action_card
        title="Gérer les albums"
        description="Créer, modifier et organiser vos albums photo"
        icon="hero-folder"
        color="blue"
        navigate={~p"/admin/albums"}
      />
      
<!-- Créer un album -->
      <.action_card
        title="Créer un album"
        description="Ajouter un nouvel album à votre portfolio"
        icon="hero-plus"
        color="green"
        navigate={~p"/admin/albums/new"}
      />
      
<!-- Modifier le profil -->
      <.action_card
        title="Mon profil"
        description="Modifier vos informations personnelles"
        icon="hero-user"
        color="purple"
        navigate={~p"/admin/profile"}
      />
    </div>
  </section>
  
<!-- Informations système -->
  <section>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations</h2>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-gray-600">Email du compte</dt>
          <dd class="mt-1 text-sm text-gray-900">{@current_user.email}</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Rôle</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              {String.capitalize(to_string(@current_user.role))}
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Compte créé le</dt>
          <dd class="mt-1 text-sm text-gray-900">
            {Calendar.strftime(@current_user.inserted_at, "%d/%m/%Y à %H:%M")}
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Dernière mise à jour</dt>
          <dd class="mt-1 text-sm text-gray-900">
            {Calendar.strftime(@current_user.updated_at, "%d/%m/%Y à %H:%M")}
          </dd>
        </div>
      </dl>
    </div>
  </section>
</div>
