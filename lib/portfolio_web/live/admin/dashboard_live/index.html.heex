<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- En-tête -->
  <header class="mb-8 flex items-start justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        Tableau de bord administrateur
      </h1>
      <p class="mt-2 text-gray-600">
        Bienvenue, {@current_user.email}
      </p>
    </div>
    <.admin_logout_button current_user={@current_user} />
  </header>

<!-- Statistiques -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Statistiques</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Total Albums -->
      <.stat_card
        title="Total Albums"
        value={@stats.total_albums}
        icon="hero-folder"
        color="blue"
        navigate={~p"/admin/albums"}
      >
        <:footer>
          <div class="flex items-center text-sm text-blue-600 font-medium">
            <span>Voir la liste</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </div>
        </:footer>
      </.stat_card>

<!-- Total Photos -->
      <.stat_card
        title="Total Photos"
        value={@stats.total_photos}
        icon="hero-photo"
        color="green"
        navigate={~p"/admin/photos"}
      />

<!-- Albums Publiés -->
      <.stat_card
        title="Albums Publiés"
        value={@stats.published_albums}
        icon="hero-check-circle"
        color="purple"
        navigate={~p"/admin/albums?filter=published"}
      >
        <:footer>
          <div class="text-sm text-gray-600">
            <%= if @stats.total_albums > 0 do %>
              {Float.round(@stats.published_albums / @stats.total_albums * 100, 1)}% du total
            <% else %>
              0% du total
            <% end %>
          </div>
        </:footer>
      </.stat_card>

<!-- Albums Brouillons -->
      <.stat_card
        title="Albums Brouillons"
        value={@stats.draft_albums}
        icon="hero-pencil-square"
        color="red"
        navigate={~p"/admin/albums?filter=draft"}
      >
        <:footer>
          <div class="text-sm text-gray-600">
            <%= if @stats.total_albums > 0 do %>
              {Float.round(@stats.draft_albums / @stats.total_albums * 100, 1)}% du total
            <% else %>
              0% du total
            <% end %>
          </div>
        </:footer>
      </.stat_card>

<!-- Utilisateurs -->
      <.stat_card
        title="Utilisateurs"
        value={@stats.total_users}
        icon="hero-users"
        color="orange"
        navigate={~p"/admin/users"}
      >
        <:footer>
          <div class="flex items-center text-sm text-orange-600 font-medium">
            <span>Voir la liste</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </div>
        </:footer>
      </.stat_card>
    </div>
  </section>

<!-- Image Processing Monitoring -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Traitement des Images</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Processing Status Card -->
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Statut de Traitement</h3>

        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-yellow-100 text-yellow-600 mr-3">
                <.icon name="hero-clock" class="w-5 h-5" />
              </span>
              <span class="text-sm font-medium text-gray-700">En attente</span>
            </div>
            <span class="text-lg font-semibold text-gray-900">
              {@processing_stats.stats.pending}
            </span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-600 mr-3">
                <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
              <span class="text-sm font-medium text-gray-700">En cours</span>
            </div>
            <span class="text-lg font-semibold text-gray-900">
              {@processing_stats.stats.processing}
            </span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600 mr-3">
                <.icon name="hero-check-circle" class="w-5 h-5" />
              </span>
              <span class="text-sm font-medium text-gray-700">Terminées</span>
            </div>
            <span class="text-lg font-semibold text-gray-900">
              {@processing_stats.stats.completed}
            </span>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-red-100 text-red-600 mr-3">
                <.icon name="hero-x-circle" class="w-5 h-5" />
              </span>
              <span class="text-sm font-medium text-gray-700">Échouées</span>
            </div>
            <span class="text-lg font-semibold text-red-600 font-bold">
              {@processing_stats.stats.failed}
            </span>
          </div>

          <div class="pt-3 border-t border-gray-200">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-gray-900">Total</span>
              <span class="text-xl font-bold text-gray-900">
                {@processing_stats.stats.total}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Storage Usage Card -->
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Stockage</h3>

        <div class="mb-4">
          <div class="flex items-end justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">Espace utilisé</span>
            <span class="text-2xl font-bold text-gray-900">
              {@processing_stats.storage_gb} GB
            </span>
          </div>
          <div class="flex items-center justify-between text-sm text-gray-600">
            <span>Sur {@processing_stats.storage_capacity_gb} GB disponibles</span>
            <span class="font-medium">{@processing_stats.storage_percentage}%</span>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="relative w-full h-4 bg-gray-200 rounded-full overflow-hidden">
          <div
            class={[
              "absolute top-0 left-0 h-full rounded-full transition-all duration-300",
              if(@processing_stats.storage_percentage >= 90, do: "bg-red-500", else: ""),
              if(@processing_stats.storage_percentage >= 70 and @processing_stats.storage_percentage < 90,
                do: "bg-yellow-500",
                else: ""
              ),
              if(@processing_stats.storage_percentage < 70, do: "bg-green-500", else: "")
            ]}
            style={"width: #{@processing_stats.storage_percentage}%"}
          >
          </div>
        </div>

        <!-- Oldest Pending Photo -->
        <%= if @processing_stats.oldest_pending do %>
          <div class="mt-6 pt-4 border-t border-gray-200">
            <p class="text-sm font-medium text-gray-700 mb-1">Photo en attente la plus ancienne</p>
            <p class="text-xs text-gray-500">
              Il y a {time_ago(@processing_stats.oldest_pending.inserted_at)}
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Failed Photos List -->
    <%= if length(@processing_stats.failed_photos) > 0 do %>
      <div class="bg-red-50 rounded-lg border border-red-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-medium text-red-900">
            Photos Échouées ({length(@processing_stats.failed_photos)})
          </h3>
          <button
            type="button"
            phx-click="retry_all_failed"
            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
          >
            <.icon name="hero-arrow-path" class="w-4 h-4 mr-2" />
            Tout relancer
          </button>
        </div>

        <div class="space-y-3">
          <%= for photo <- @processing_stats.failed_photos do %>
            <div class="bg-white rounded-lg p-4 flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <img
                  src={photo.file_path}
                  alt={photo.original_filename}
                  class="w-16 h-16 object-cover rounded"
                />
                <div>
                  <p class="text-sm font-medium text-gray-900">{photo.original_filename}</p>
                  <p class="text-xs text-gray-500">
                    Album: {if photo.album, do: photo.album.title, else: "N/A"}
                  </p>
                  <p class="text-xs text-gray-500">
                    Il y a {time_ago(photo.updated_at)}
                  </p>
                </div>
              </div>
              <.link
                navigate={if photo.album, do: ~p"/admin/albums/#{photo.album.id}/edit", else: "#"}
                class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              >
                Voir l'album
              </.link>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

<!-- Actions rapides -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Actions rapides</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Gérer les albums -->
      <.action_card
        title="Gérer les albums"
        description="Créer, modifier et organiser vos albums photo"
        icon="hero-folder"
        color="blue"
        navigate={~p"/admin/albums"}
      />

<!-- Créer un album -->
      <.action_card
        title="Créer un album"
        description="Ajouter un nouvel album à votre portfolio"
        icon="hero-plus"
        color="green"
        navigate={~p"/admin/albums/new"}
      />

<!-- Modifier le profil -->
      <.action_card
        title="Mon profil"
        description="Modifier vos informations personnelles"
        icon="hero-user"
        color="purple"
        navigate={~p"/admin/profile"}
      />
    </div>
  </section>

<!-- Informations système -->
  <section>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Informations</h2>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-gray-600">Email du compte</dt>
          <dd class="mt-1 text-sm text-gray-900">{@current_user.email}</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Rôle</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              {String.capitalize(to_string(@current_user.role))}
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Compte créé le</dt>
          <dd class="mt-1 text-sm text-gray-900">
            {Calendar.strftime(@current_user.inserted_at, "%d/%m/%Y à %H:%M")}
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-600">Dernière mise à jour</dt>
          <dd class="mt-1 text-sm text-gray-900">
            {Calendar.strftime(@current_user.updated_at, "%d/%m/%Y à %H:%M")}
          </dd>
        </div>
      </dl>
    </div>
  </section>
</div>
