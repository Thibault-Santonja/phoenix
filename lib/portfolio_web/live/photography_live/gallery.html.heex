<div class="h-screen flex flex-col gap-4 py-2">
  <%!-- Per-album meta description for SEO --%>
  <meta :if={@meta_description} name="description" content={@meta_description} />
  <meta :if={@meta_description} property="og:description" content={@meta_description} />
  <meta :if={@meta_description} name="twitter:description" content={@meta_description} />

  <nav class={[
    "sticky top-0 px-4",
    "flex-none flex items-center",
    "text-sm"
  ]}>
    <h1 class="flex flex-col items-end group">
      <a href={~p"/"}>
        {gettext("photography.author_name")}
        <p class="duration-300 opacity-60 group-hover:opacity-100 text-xs">
          {gettext("navigation.home")}
        </p>
      </a>
    </h1>
    <div class="grow flex justify-end gap-4">
      <.switch_theme_button />

      <.dropdown id="language" smart_position={true} clickable>
        <:trigger>
          <.icon
            name="hero-language-solid"
            class={[
              "h-6 w-6",
              "mx-2"
            ]}
          />
        </:trigger>

        <.dropdown_content rounded="large" padding="extra_small" class="z-50">
          <.list size="small">
            <:item>
              <button class="hover:font-black" phx-click="change_locale" phx-value-locale="fr">
                Français
              </button>
            </:item>
            <:item>
              <button class="hover:font-black" phx-click="change_locale" phx-value-locale="en">
                English
              </button>
            </:item>
          </.list>
        </.dropdown_content>
      </.dropdown>
    </div>
  </nav>

  <%!-- Palier 4 : le catalogue est injoignable. La page reste complète, en 200,
  et dit ce qui se passe plutôt que de montrer un contenu inventé. --%>
  <section :if={@unavailable} class="grow flex flex-col items-center justify-center gap-6 px-4">
    <p class="max-w-prose text-center text-sm opacity-80">
      {gettext("photography.catalog_unavailable")}
    </p>
    <a
      href={~p"/timeline"}
      class={[
        "inline-flex items-center gap-2",
        "py-2 px-4",
        "text-sm border-gray-300 rounded-lg border-2",
        "hover:scale-105 duration-300"
      ]}
    >
      {gettext("photography.gallery")}
    </a>
  </section>

  <section
    :if={not @unavailable}
    class={[
      "grow md:pl-4 max-h-full min-h-0",
      "flex flex-col-reverse md:flex-row md:gap-16 overflow-hidden justify-end"
    ]}
  >
    <header
      id={"project-title-#{@project_id}"}
      class="px-4 md:px-0 md:py-8 project-title z-10 opacity-0 duration-300 ease-in md:max-w-[33%]"
    >
      <h2 class="uppercase text-xl mb-2 md:mb-4 font-black">{@album.title}</h2>
      <p class="leading-relaxed text-sm opacity-80 font-light">
        {(@photo && @photo.caption) || @album.description}
      </p>

      <button
        phx-click={JS.navigate(~p"/timeline")}
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          >
          </path>
        </svg>
        {gettext("navigation.back")}
      </button>
    </header>

    <a
      :if={@photo}
      class={[
        "group max-h-full min-h-0 min-w-1/2 px-4",
        "md:grow"
      ]}
      href={@album.canonical_url}
    >
      <picture>
        <source :if={srcset(@photo, "avif")} type="image/avif" srcset={srcset(@photo, "avif")} />
        <source :if={srcset(@photo, "webp")} type="image/webp" srcset={srcset(@photo, "webp")} />
        <img
          id={"project-image-#{@project_id}"}
          phx-hook="AnimatePhotographyGallery"
          class={[
            "max-h-full max-w-full",
            "-z-10 ml-auto object-contain",
            "opacity-0 duration-1000 ease-in-out translate-y-8"
          ]}
          alt={@photo.alt}
          loading="lazy"
          decoding="async"
          style={aspect_ratio(@photo) && "aspect-ratio: #{aspect_ratio(@photo)}"}
          src={fallback_url(@photo)}
        />
      </picture>

      <span class={[
        "block w-full pr-4 pt-1",
        "text-right text-xs",
        "opacity-20 group-hover:opacity-100 duration-300"
      ]}>
        {gettext("photography.go_to_album")} ({String.to_integer(@project_id) + 1} - {@pictures})
      </span>
    </a>
  </section>

  <section
    :if={not @unavailable}
    class={[
      "flex-none w-screen px-4 h-24 sm:h-36 md:h-48 "
    ]}
  >
    <ul
      id="project-list"
      phx-hook="HorizontalScrollFadeIn"
      class={[
        "overflow-x-auto h-24 sm:h-36 md:h-48 overflow-y-hidden",
        "grid grid-flow-col grid-rows-1 gap-2"
      ]}
    >
      <%= for {photo, index} <- Enum.with_index(@photos) do %>
        <li class="w-36 sm:w-48 md:w-64 mx-auto opacity-0 transition-opacity duration-300 ease-in">
          <button phx-click="show_project" phx-value-project={index} class="size-full">
            <img
              class="size-full object-cover"
              alt={photo.alt}
              src={thumbnail_url(photo)}
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      <% end %>
    </ul>
  </section>
</div>
