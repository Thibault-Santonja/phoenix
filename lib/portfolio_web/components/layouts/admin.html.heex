<div class="app" id="admin-shell">
  <a href="#main" class="skip-link">Aller au contenu</a>

  <aside class="app-side" aria-label="Navigation de l'administration">
    <div class="app-side__brand">
      <.link navigate={~p"/admin"} class="app-side__name">Thibault San</.link>
      <span class="app-side__space">Administration</span>
    </div>

    <nav class="app-side__nav" aria-label="Sections de l'administration">
      <div class="app-nav-group">
        <p class="app-nav-group__title" id="nav-pilotage">Pilotage</p>
        <ul class="app-nav-group__list" aria-labelledby="nav-pilotage">
          <li>
            <.link
              navigate={~p"/admin"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Tableau de bord")}
            >
              Tableau de bord
            </.link>
          </li>
        </ul>
      </div>

      <div class="app-nav-group">
        <p class="app-nav-group__title" id="nav-galerie">Galerie</p>
        <ul class="app-nav-group__list" aria-labelledby="nav-galerie">
          <li>
            <.link
              navigate={~p"/admin/albums"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Albums")}
            >
              Albums
            </.link>
          </li>
          <li>
            <.link
              navigate={~p"/admin/photos"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Photos")}
            >
              Photos
            </.link>
          </li>
        </ul>
      </div>

      <div class="app-nav-group">
        <p class="app-nav-group__title" id="nav-compte">Compte</p>
        <ul class="app-nav-group__list" aria-labelledby="nav-compte">
          <li>
            <.link
              navigate={~p"/admin/users"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Utilisateurs")}
            >
              Utilisateurs
            </.link>
          </li>
          <li>
            <.link
              navigate={~p"/admin/profile"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Mon profil")}
            >
              Mon profil
            </.link>
          </li>
          <li>
            <.link
              navigate={~p"/admin/ip-whitelist"}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, "Adresses autorisees")}
            >
              Adresses autorisees
            </.link>
          </li>
        </ul>
      </div>
    </nav>

    <div class="app-side__foot">
      <div class="app-account">
        <span class="app-account__avatar" aria-hidden="true">
          {admin_initials(@current_user)}
        </span>
        <span class="app-account__id">
          <span class="app-account__name">{@current_user && @current_user.email}</span>
          <span class="app-account__role">{admin_role_label(@current_user)}</span>
        </span>
      </div>
      <.link href={~p"/logout"} method="delete" class="app-side__logout">
        <.icon name="hero-arrow-right-start-on-rectangle" class="size-4" /> Deconnexion
      </.link>
    </div>
  </aside>

  <div class="app-body">
    <div class="app-mobilebar">
      <.link navigate={~p"/admin"} class="app-mobilebar__name">Thibault San</.link>
      <details class="app-mobile-nav">
        <summary class="app-iconbtn" aria-label="Ouvrir le menu">
          <.icon name="hero-bars-3" class="size-4" />
        </summary>
        <nav class="app-mobile-nav__panel" aria-label="Sections de l'administration (mobile)">
          <ul class="app-nav-group__list">
            <li><.link navigate={~p"/admin"} class="app-nav-link">Tableau de bord</.link></li>
            <li><.link navigate={~p"/admin/albums"} class="app-nav-link">Albums</.link></li>
            <li><.link navigate={~p"/admin/photos"} class="app-nav-link">Photos</.link></li>
            <li><.link navigate={~p"/admin/users"} class="app-nav-link">Utilisateurs</.link></li>
            <li><.link navigate={~p"/admin/profile"} class="app-nav-link">Mon profil</.link></li>
            <li>
              <.link navigate={~p"/admin/ip-whitelist"} class="app-nav-link">
                Adresses autorisees
              </.link>
            </li>
          </ul>
        </nav>
      </details>
    </div>

    <header class="app-top">
      <div class="app-top__head">
        <nav aria-label="Fil d'Ariane">
          <ol class="app-crumbs">
            <li aria-current="page">{assigns[:page_title] || "Administration"}</li>
          </ol>
        </nav>
        <h1 class="app-top__title">{assigns[:page_title] || "Administration"}</h1>
      </div>

      <div class="app-top__actions">
        <.link href={~p"/"} class="app-top__site">
          <.icon name="hero-globe-alt" class="size-4" /> Voir le site
        </.link>

        <details class="app-menu">
          <summary class="app-menu__summary" aria-label="Menu du compte">
            Compte <.icon name="hero-chevron-down" class="size-3" />
          </summary>
          <div class="app-menu__panel" role="menu">
            <.link class="app-menu__item" role="menuitem" navigate={~p"/admin/profile"}>
              Mon profil
            </.link>
            <hr class="app-menu__sep" />
            <.link class="app-menu__item" role="menuitem" href={~p"/logout"} method="delete">
              Deconnexion
            </.link>
          </div>
        </details>
      </div>
    </header>

    <main class="app-main" id="main">
      {@inner_content}
    </main>
  </div>

  <.flash_group flash={@flash} />
</div>
