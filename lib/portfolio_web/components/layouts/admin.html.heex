<div class="app" id="admin-shell">
  <a href="#main" class="skip-link">{gettext("admin.shell.skip_to_content")}</a>

  <aside class="app-side" aria-label={gettext("admin.shell.sidebar_label")}>
    <div class="app-side__brand">
      <.link navigate={~p"/admin"} class="app-side__name">Thibault San</.link>
      <span class="app-side__space">{gettext("admin.shell.space")}</span>
    </div>

    <nav class="app-side__nav" aria-label={gettext("admin.shell.nav_label")}>
      <div :for={group <- admin_nav_groups()} class="app-nav-group">
        <p class="app-nav-group__title" id={"nav-#{group.id}"}>{group.title}</p>
        <ul class="app-nav-group__list" aria-labelledby={"nav-#{group.id}"}>
          <li :for={item <- group.items}>
            <.link
              navigate={item.path}
              class="app-nav-link"
              aria-current={admin_nav_current?(assigns, item.path)}
            >
              {item.label}
            </.link>
          </li>
        </ul>
      </div>
    </nav>

    <div class="app-side__foot">
      <div class="app-account">
        <span class="app-account__avatar" aria-hidden="true">
          {admin_initials(@current_user)}
        </span>
        <span class="app-account__id">
          <span class="app-account__name">{@current_user && @current_user.email}</span>
          <span class="app-account__role">{admin_role_label(@current_user)}</span>
        </span>
      </div>
      <.link href={~p"/logout"} method="delete" class="app-side__logout">
        <.icon name="hero-arrow-right-start-on-rectangle" class="size-4" />
        {gettext("admin.shell.logout")}
      </.link>
    </div>
  </aside>

  <div class="app-body">
    <div class="app-mobilebar">
      <.link navigate={~p"/admin"} class="app-mobilebar__name">Thibault San</.link>
      <details class="app-mobile-nav">
        <summary class="app-iconbtn" aria-label={gettext("admin.shell.open_menu")}>
          <.icon name="hero-bars-3" class="size-4" />
        </summary>
        <nav class="app-mobile-nav__panel" aria-label={gettext("admin.shell.nav_label_mobile")}>
          <ul class="app-nav-group__list">
            <li :for={item <- admin_nav_items()}>
              <.link
                navigate={item.path}
                class="app-nav-link"
                aria-current={admin_nav_current?(assigns, item.path)}
              >
                {item.label}
              </.link>
            </li>
          </ul>
        </nav>
      </details>
    </div>

    <header class="app-top">
      <div class="app-top__head">
        <nav aria-label={gettext("admin.shell.breadcrumb_label")}>
          <ol class="app-crumbs">
            <li :for={crumb <- admin_crumbs(assigns)}>
              <.link :if={crumb.path} navigate={crumb.path}>{crumb.label}</.link>
              <span :if={is_nil(crumb.path)} aria-current="page">{crumb.label}</span>
            </li>
          </ol>
        </nav>
        <h1 class="app-top__title">{assigns[:page_title] || gettext("admin.shell.space")}</h1>
      </div>

      <div class="app-top__actions">
        <.link href={~p"/"} class="app-top__site">
          <.icon name="hero-globe-alt" class="size-4" /> {gettext("admin.shell.view_site")}
        </.link>

        <details class="app-menu">
          <summary class="app-menu__summary" aria-label={gettext("admin.shell.account_menu")}>
            {gettext("admin.shell.account")} <.icon name="hero-chevron-down" class="size-3" />
          </summary>
          <div class="app-menu__panel" role="menu">
            <.link class="app-menu__item" role="menuitem" navigate={~p"/admin/profile"}>
              {gettext("admin.nav.profile")}
            </.link>
            <hr class="app-menu__sep" />
            <.link class="app-menu__item" role="menuitem" href={~p"/logout"} method="delete">
              {gettext("admin.shell.logout")}
            </.link>
          </div>
        </details>
      </div>
    </header>

    <main class="app-main" id="main">
      {@inner_content}
    </main>
  </div>

  <.flash_group flash={@flash} />
</div>
