<!DOCTYPE html>
<html lang="fr" class="[scrollbar-gutter:stable] scroll-smooth">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <!-- Langue principale -->
    <meta name="language" content={Gettext.get_locale()} />
    <meta http-equiv="content-language" content={Gettext.get_locale()} />
    <!-- Open Graph pour SEO et réseaux sociaux -->
    <meta
      property="og:locale"
      content={if Gettext.get_locale() == "fr", do: "fr_FR", else: "en_GB"}
    />
    <meta property="og:locale:alternate" content="fr_BE" />
    <meta property="og:locale:alternate" content="fr_CH" />
    <meta property="og:locale:alternate" content="en_US" />
    <!-- Hreflang pour le ciblage international (France, Suisse, Belgique) -->
    <link rel="alternate" hreflang="fr" href="https://thibaultsan.com/" />
    <link rel="alternate" hreflang="fr-FR" href="https://thibaultsan.com/" />
    <link rel="alternate" hreflang="fr-CH" href="https://thibaultsan.com/" />
    <link rel="alternate" hreflang="fr-BE" href="https://thibaultsan.com/" />
    <link rel="alternate" hreflang="en" href="https://thibaultsan.com/" />
    <link rel="alternate" hreflang="x-default" href="https://thibaultsan.com/" />

    <.live_title default="Digital Workshop and Portfolio" suffix=" · Thibault Santonja">
      {assigns[:page_title]}
    </.live_title>
    <title>{gettext("layouts.root.title")}</title>
    <meta name="description" content={gettext("layouts.root.description")} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thibaultsan.com/" />
    <meta property="og:title" content={gettext("layouts.root.og_title")} />
    <meta property="og:description" content={gettext("layouts.root.og_description")} />
    <meta property="og:image" content="https://thibaultsan.com/images/photography/landscape.webp" />
    <meta property="og:image:alt" content="Thibault Santonja background photography" />
    <meta property="og:site_name" content="Thibault San" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={gettext("layouts.root.twitter_title")} />
    <meta name="twitter:description" content={gettext("layouts.root.twitter_description")} />
    <meta
      name="twitter:image"
      content="https://thibaultsan.com/images/photography/landscape.webp"
    />
    <meta name="twitter:image:alt" content="Thibault Santonja background photography" />

    <link rel="canonical" href="https://thibaultsan.com/" />
    <link rel="icon" type="image/x-icon" href="/images/photography/logo.webp" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <!-- preload background image -->

    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
      nonce={assigns[:csp_nonce]}
    >
    </script>
  </head>

  <body id="root" class="bg-black">
    {@inner_content}
  </body>
</html>
